# Production / Tuning Configuration for the Scraper
APP_HOST=127.0.0.1
APP_PORT=5001

# Web scraping power controls (for Deep/Ultra modes)
WEB_MAX_PAGES=16
WEB_TIMEOUT_SEC=30

# Email/web enrichment parallelism
EMAIL_ENRICHMENT_MAX_TARGETS=160
EMAIL_ENRICHMENT_WORKERS=6

# Optional: enable more verbose logging
# LOG_LEVEL=DEBUG
